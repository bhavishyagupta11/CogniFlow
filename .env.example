# CogniFlow Environment Configuration Template
# Copy this file to .env and fill in your values. DO NOT commit .env to source control.

# Provider (openrouter, ollama, openai, anthropic)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash

# Authentication (Required for OpenRouter/OpenAI/Anthropic)
OPENROUTER_API_KEY=
# LLM_API_KEY=

# LLM Tunables
LLM_TIMEOUT=30000
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.4
LLM_TOP_P=1.0
LLM_STREAM=false

# App Settings
UPLOAD_ACCESS_KEY=
DATABASE_URL=file:./db/custom.db
NODE_ENV=development
