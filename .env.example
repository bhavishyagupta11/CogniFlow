# CogniFlow Environment Configuration Template
# Copy this file to .env and fill in your values. DO NOT commit .env to source control.

# Provider (openrouter, ollama, openai, anthropic)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash

# Authentication (Required for Google Gemini / OpenRouter / Anthropic)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# LLM_API_KEY=

# LLM Tunables
LLM_TIMEOUT=30000
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.4
LLM_TOP_P=1.0
LLM_STREAM=false

# App Settings & Networking
PORT=3001
HOST=0.0.0.0
VITE_API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_ACCESS_KEY=
JWT_SECRET=
NODE_ENV=development

# Relational Persistence (Supabase PostgreSQL in production, or SQLite in local dev)
# Supabase Transaction Pooler: postgresql://postgres.[ref]:[pwd]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Object Storage (Cloudflare R2 in production, or local filesystem in local dev)
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cogniflow-storage
R2_ENDPOINT=
CLOUDFLARE_API_TOKEN=
R2_API_TOKEN=
